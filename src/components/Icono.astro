---
/**
 * ICONO (SVG en línea)
 * Iconos propios y decorativos: no contienen información, por eso se
 * ocultan a lectores de pantalla (aria-hidden). Cero peticiones extra.
 */
interface Props {
  /** Nombre del icono: codigo, red, escudo, grafico, equipo, proyecto, examen, puerta o corazon. */
  nombre: string;
}

const { nombre } = Astro.props;

const trazos: Record<string, string> = {
  codigo: '<polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/><line x1="14" y1="4" x2="10" y2="20"/>',
  red: '<circle cx="12" cy="5" r="2.5"/><circle cx="5" cy="19" r="2.5"/><circle cx="19" cy="19" r="2.5"/><path d="M12 7.5v4M10.2 13.2 6.8 16.8M13.8 13.2l3.4 3.6"/><circle cx="12" cy="12" r="1.5"/>',
  escudo: '<path d="M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6z"/><path d="M8.5 12l2.5 2.5 4.5-5"/>',
  grafico: '<path d="M4 20V11M10 20V4M16 20v-7M22 20H2"/>',
  equipo: '<circle cx="9" cy="8" r="3"/><circle cx="17" cy="9" r="2.5"/><path d="M3 20c0-3.5 2.7-6 6-6s6 2.5 6 6M15 14.5c3 0 6 1.7 6 5.5"/>',
  proyecto: '<rect x="3" y="4" width="18" height="16" rx="2"/><path d="M9 4v16M15 4v10"/>',
  examen: '<rect x="5" y="3" width="14" height="18" rx="2"/><path d="M9 8h6M9 12h6M9 16h3"/>',
  puerta: '<path d="M6 21V4a1 1 0 0 1 1-1h10a1 1 0 0 1 1 1v17M3 21h18"/><circle cx="15" cy="12" r="0.8"/>',
  corazon: '<path d="M12 21s-7-4.5-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 11c0 5.5-7 10-7 10z"/>',
};

const contenido = trazos[nombre] ?? '';
---

<svg
  class="icono"
  viewBox="0 0 24 24"
  width="24"
  height="24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  set:html={contenido}
/>
