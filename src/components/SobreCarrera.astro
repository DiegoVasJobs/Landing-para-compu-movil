---
/**
 * SOBRE LA CARRERA
 * Responde "¿En qué se diferencia?": compara con 2 carreras afines
 * (datos oficiales) y agrega el análisis del equipo, etiquetado como
 * interpretación.
 */
import type { CollectionEntry } from 'astro:content';
import type { SeccionMeta } from '../lib/contenido';
import Seccion from './Seccion.astro';
import Cita from './Cita.astro';
import Etiqueta from './Etiqueta.astro';

interface Props {
  meta: SeccionMeta;
  carrera: CollectionEntry<'carrera'>['data'];
}

const { meta, carrera } = Astro.props;
---

<Seccion id={meta.id} titulo={meta.titulo} pregunta={meta.pregunta}>
  <div class="tabla-desplazable" role="region" aria-labelledby="tabla-afines" tabindex="0">
    <table class="comparacion">
      <caption id="tabla-afines">Comparación con carreras afines de la UTEM</caption>
      <thead>
        <tr>
          <th scope="col">Carrera</th>
          <th scope="col">Duración</th>
          <th scope="col">Grado</th>
          <th scope="col">Enfoque</th>
        </tr>
      </thead>
      <tbody>
        <tr class="comparacion__destacada">
          <th scope="row">{carrera.nombreOficial} ({carrera.codigoDemre})</th>
          <td data-etiqueta="Duración">{carrera.duracionSemestres} semestres</td>
          <td data-etiqueta="Grado">{carrera.grado}</td>
          <td data-etiqueta="Enfoque">
            {carrera.proposito.texto}
            <Cita fuentes={carrera.proposito.fuentes} />
          </td>
        </tr>
        {
          carrera.afines.map((afin) => (
            <tr>
              <th scope="row">
                {afin.nombre} ({afin.codigoDemre})
              </th>
              <td data-etiqueta="Duración">{afin.duracionSemestres} semestres</td>
              <td data-etiqueta="Grado">{afin.grado}</td>
              <td data-etiqueta="Enfoque">
                {afin.enfoque}
                <Cita fuentes={afin.fuentes} />
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  <div class="tarjeta interpretacion" role="note" aria-label="Interpretación del equipo">
    <Etiqueta tipo={carrera.interpretacion.tipo} />
    <p>{carrera.interpretacion.texto}</p>
  </div>
</Seccion>

<style>
  /* La tabla se desplaza dentro de su caja en móvil, sin mover toda la página. */
  .tabla-desplazable {
    overflow-x: auto;
    margin-bottom: var(--espacio-4);
  }

  .comparacion {
    width: 100%;
    min-width: 40rem;
    border-collapse: collapse;
    font-size: 0.95rem;
  }

  .comparacion caption {
    text-align: left;
    font-weight: 600;
    margin-bottom: var(--espacio-2);
  }

  .comparacion th,
  .comparacion td {
    padding: var(--espacio-2) var(--espacio-3);
    border-bottom: 1px solid var(--color-borde);
    text-align: left;
    vertical-align: top;
  }

  .comparacion thead th {
    background: var(--color-fondo-suave);
  }

  .comparacion__destacada {
    background: var(--etiqueta-dato-fondo);
  }

  /*
   * En celulares (menos de 48rem) la tabla se muestra como tarjetas apiladas:
   * cada carrera es una tarjeta y cada dato lleva su etiqueta (data-etiqueta).
   * Corrección de la prueba con usuarios: la tabla ancha era incómoda en el celular.
   */
  @media (max-width: 47.99rem) {
    .comparacion {
      min-width: 0;
    }

    .comparacion thead {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
    }

    .comparacion tr {
      display: block;
      margin-bottom: var(--espacio-3);
      border: 1px solid var(--color-borde);
      border-radius: var(--radio);
      background: var(--color-fondo);
    }

    .comparacion th,
    .comparacion td {
      display: block;
      border-bottom: none;
    }

    .comparacion tbody th {
      font-size: 1.05rem;
      border-bottom: 1px solid var(--color-borde);
    }

    .comparacion td::before {
      content: attr(data-etiqueta) ': ';
      font-weight: 700;
    }
  }

  .interpretacion {
    border-left: 4px solid var(--etiqueta-interpretacion-texto);
  }

  .interpretacion p {
    margin: var(--espacio-2) 0 0;
  }
</style>
