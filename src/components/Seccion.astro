---
/**
 * ENVOLTORIO DE SECCIÓN
 * Estructura común de cada sección: <section> con su título (h2) y la
 * pregunta del postulante que responde. Mantiene la jerarquía de
 * encabezados correcta (h1 en portada, h2 por sección, h3 dentro).
 */
interface Props {
  id: string;
  titulo: string;
  pregunta: string;
  /** Fondo gris suave para alternar secciones y facilitar la lectura. */
  suave?: boolean;
  /** Banda azul oscuro para dar ritmo visual (texto claro). */
  oscura?: boolean;
}

const { id, titulo, pregunta, suave = false, oscura = false } = Astro.props;
---

<section id={id} class:list={['seccion', { 'seccion--suave': suave, 'seccion--oscura': oscura }]} aria-labelledby={`${id}-titulo`}>
  <div class="contenedor">
    <h2 id={`${id}-titulo`}>{titulo}</h2>
    <p class="seccion__pregunta">{pregunta}</p>
    <slot />
  </div>
</section>

<style>
  .seccion {
    padding-block: var(--espacio-5);
  }

  .seccion--suave {
    background: var(--color-fondo-suave);
  }

  .seccion--oscura {
    background: linear-gradient(135deg, #083a66, #0b4f8a);
  }

  .seccion--oscura h2 {
    color: #ffffff;
  }

  .seccion--oscura h2::after {
    background: #99f6e4;
  }

  .seccion--oscura .seccion__pregunta {
    color: #d6e4f2;
  }

  .seccion__pregunta {
    font-size: 1.15rem;
    color: var(--color-texto-suave);
    margin-bottom: var(--espacio-4);
  }

  @media (min-width: 48rem) {
    .seccion {
      padding-block: var(--espacio-6);
    }
  }
</style>
