---
/**
 * RESPALDO INSTITUCIONAL
 * Responde "¿Qué garantías hay?": acreditación, certificación de la
 * carrera, plan oficial y (cuando se agregue) cuerpo académico.
 */
import { getEntry, type CollectionEntry } from 'astro:content';
import type { SeccionMeta } from '../lib/contenido';
import Seccion from './Seccion.astro';
import Cita from './Cita.astro';
import Etiqueta from './Etiqueta.astro';
import { rutaPublica } from '../lib/rutas';

interface Props {
  meta: SeccionMeta;
  items: CollectionEntry<'respaldo'>[];
}

const { meta, items } = Astro.props;

// Foto propia del campus (fotos.json exige texto alternativo y crédito).
const foto = (await getEntry('fotos', 'campus'))?.data;
---

<Seccion id={meta.id} titulo={meta.titulo} pregunta={meta.pregunta} oscura>
  <ul class="grilla respaldo">
    {
      items.map(({ data }) => (
        <li class="tarjeta">
          <Etiqueta tipo={data.tipo} />
          <h3 class="respaldo__titulo">{data.titulo}</h3>
          <p class="respaldo__valor">{data.valorDestacado}</p>
          <p>{data.descripcion}</p>
          <Cita fuentes={data.fuentes} anio={data.anio} />
        </li>
      ))
    }
  </ul>

  {
    foto && (
      <figure class="campus">
        <img
          src={rutaPublica(foto.archivo)}
          srcset={`${rutaPublica(foto.archivoMenor)} ${foto.anchoMenor}w, ${rutaPublica(foto.archivo)} ${foto.ancho}w`}
          sizes="(min-width: 72rem) 70rem, 100vw"
          width={foto.ancho}
          height={foto.alto}
          alt={foto.alt}
          loading="lazy"
          decoding="async"
        />
        <figcaption>{foto.credito}</figcaption>
      </figure>
    )
  }
</Seccion>

<style>
  .respaldo {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .campus {
    margin: var(--espacio-5) 0 0;
  }

  .campus img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radio);
  }

  .campus figcaption {
    margin-top: var(--espacio-2);
    font-size: 0.9rem;
    color: #d6e4f2;
  }

  .respaldo__titulo {
    margin: var(--espacio-2) 0 var(--espacio-1);
  }

  .respaldo__valor {
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--color-acento);
  }
</style>
